# Copy this file to .env and fill in the values from the Azure portal.
# .env is in .gitignore: it is never committed.

# Azure portal > your Azure OpenAI resource > Keys and Endpoint > "Endpoint"
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/

# Same page, "KEY 1"
AZURE_OPENAI_API_KEY=

# The deployment name you chose when deploying the model (not the model name)
AZURE_OPENAI_DEPLOYMENT=
